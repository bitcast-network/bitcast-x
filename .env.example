# Chain and wallet (replace the wallet hotkey/path if yours differ)
BITCAST_X_NETWORK=finney
BITCAST_X_NETUID=93
BITCAST_X_MECHANISM_ID=1
BITCAST_X_WALLET_NAME=default
BITCAST_X_WALLET_HOTKEY=default
BITCAST_X_WALLET_PATH=/home/miner/.bittensor/wallets

# Reference miner endpoint and durable state
BITCAST_X_HOST=0.0.0.0
BITCAST_X_PORT=8095
# Required for miners; set this to the host's externally reachable IP.
# BITCAST_X_PUBLIC_IP=203.0.113.10
BITCAST_X_STATE_DIR=/var/lib/bitcast-x
BITCAST_X_VALIDATOR_REQUESTS_PER_MINUTE=120
BITCAST_X_PENDING_MAX_EVENTS=10000
BITCAST_X_PENDING_MAX_BYTES=50000000

# Published public protocol configuration; operators should not need to change these values.
BITCAST_X_CAMPAIGN_FEED_URL=https://bitcast-api.bitcast.network/api/v2/public/x/campaign-manifest-v4
# Current full ecosystem-map snapshots are about 8 MB; keep bounded headroom.
BITCAST_X_CAMPAIGN_FEED_MAX_RESPONSE_BYTES=16000000
# Frozen v2 state imported before cutover; required while legacy campaigns remain.
BITCAST_X_LEGACY_CONNECTIONS_PATH=/var/lib/bitcast-x/connections.db
BITCAST_X_LEGACY_SNAPSHOTS_PATH=/var/lib/bitcast-x/reward_snapshots
BITCAST_X_LEGACY_TWEET_STORE_PATH=/var/lib/bitcast-x/legacy_tweet_store
BITCAST_X_LEGACY_NOCODE_UID=154
# Existing legacy registration tweet IDs.
BITCAST_X_LEGACY_CONNECTION_TWEET_IDS=2031383975088836738
BITCAST_X_LEGACY_FASTTRACK_URL=https://www.stitch3.ai/api/fast-track
# Finney netuid 93 qualification history ships with each reviewed release. Operators do not
# configure it. The legacy BITCAST_X_QUALIFICATION_* fields remain available only for other
# networks and local testing.

# Validators verify only the historical commitment blocks reported by miners.
BITCAST_X_VALIDATOR_POLL_SECONDS=12
# Keep replaceable preview refreshes responsive without bursting Desearch.
BITCAST_X_VALIDATOR_PREVIEW_MAX_CONCURRENCY=2

# External secrets are injected at runtime and never committed.
# BITCAST_X_DESEARCH_API_KEY=
BITCAST_X_LLM_PROVIDER=chutes
# BITCAST_X_CHUTES_API_KEY=
# BITCAST_X_OPENROUTER_API_KEY=
BITCAST_X_LLM_NUM_CHECKS=3
BITCAST_X_LLM_TWEET_MAX_LENGTH=10000

# Production validator outputs. Set either value false only for an intentional diagnostic run.
BITCAST_X_ENABLE_DATA_PUBLISH=true
BITCAST_X_DATA_CLIENT_URL=https://ingestion.bitcast.network:443
BITCAST_X_ENABLE_WEIGHT_SUBMISSION=true
BITCAST_X_WEIGHT_EPOCH_BLOCKS=100
BITCAST_X_WEIGHT_VERSION_KEY=0

# Validator operations endpoint and structured logging
BITCAST_X_OPS_HOST=0.0.0.0
BITCAST_X_OPS_PORT=8096
BITCAST_X_LOG_LEVEL=INFO
BITCAST_X_LOG_FORMAT=json
# Best-effort Grafana Loki forwarding uses shared write-only defaults.
# Override all three for another stack, or set BITCAST_X_LOKI_URL= to disable.
# BITCAST_X_LOKI_URL=https://logs-prod-<stack>.grafana.net
# BITCAST_X_LOKI_USERNAME=<stack-id>
# BITCAST_X_LOKI_TOKEN=<write-only-access-policy-token>

# Source-checkout validators do not update automatically unless explicitly enabled.
# Opting in applies unattended fast-forward updates from BITCAST_X_AUTO_UPDATE_REF.
# BITCAST_X_AUTO_UPDATE=true
# BITCAST_X_AUTO_UPDATE_REF=origin/main
# BITCAST_X_AUTO_UPDATE_INTERVAL_SECONDS=900
# BITCAST_X_AUTO_UPDATE_STARTUP_GRACE_SECONDS=30
# BITCAST_X_AUTO_UPDATE_SHUTDOWN_TIMEOUT_SECONDS=3600
# BITCAST_X_AUTO_UPDATE_DIR=/home/miner/.cache/bitcast-x/updates
