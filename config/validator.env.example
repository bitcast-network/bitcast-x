# Minimal PM2 environment for `bitcast-x run-validator`.
# Copy to `.env.validator`, replace every host-specific value, and chmod 0600.

# Required host-specific settings. Wallet files must already exist.
BITCAST_X_WALLET_NAME=default
BITCAST_X_WALLET_HOTKEY=default
BITCAST_X_WALLET_PATH=/absolute/path/to/.bittensor/wallets
BITCAST_X_STATE_DIR=/absolute/path/to/bitcast-x/validator-state

# Public network constants. Changing these targets another network/mechanism.
BITCAST_X_NETWORK=finney
BITCAST_X_NETUID=93
BITCAST_X_MECHANISM_ID=1
BITCAST_X_CAMPAIGN_FEED_URL=https://bitcast-api.bitcast.network/api/v2/public/x/campaign-manifest
BITCAST_X_CAMPAIGN_FEED_MAX_RESPONSE_BYTES=16000000
BITCAST_X_OPS_HOST=0.0.0.0
BITCAST_X_OPS_PORT=8096
BITCAST_X_VALIDATOR_POLL_SECONDS=12

# Production outputs. Set either value false only for an intentional diagnostic run.
BITCAST_X_ENABLE_DATA_PUBLISH=true
BITCAST_X_ENABLE_WEIGHT_SUBMISSION=true

# PM2 operators upgrade deliberately from reviewed releases.
BITCAST_X_AUTO_UPDATE=false
