# Validator-only evidence and LLM provider integrations.
# Append this to a validator `.env` or source it after `.env.validator`. Every API key below is
# secret; uncomment only the provider used by this validator and keep the private copy mode 0600.

# Required to retrieve X evidence during reconciliation.
# BITCAST_X_DESEARCH_API_KEY=

# Select one LLM provider and set only its key.
BITCAST_X_LLM_PROVIDER=chutes
# BITCAST_X_CHUTES_API_KEY=
# BITCAST_X_OPENROUTER_API_KEY=

# Number of LLM votes per evidence item (integer, 1-10).
BITCAST_X_LLM_NUM_CHECKS=3
# Maximum tweet characters submitted to the LLM provider (integer, 1-100000).
BITCAST_X_LLM_TWEET_MAX_LENGTH=10000
