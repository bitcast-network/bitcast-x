# Validator-only evidence and brief-evaluation integrations.
# Append this to a validator `.env` or source it after `.env.validator`. Every API key below is
# secret; keep the private copy mode 0600.

# Required to retrieve X evidence during reconciliation.
# BITCAST_X_DESEARCH_API_KEY=

# Required to evaluate tweets against campaign briefs.
# BITCAST_X_JEV_API_KEY=

# Maximum tweet characters submitted to JEV (integer, 1-100000).
BITCAST_X_LLM_TWEET_MAX_LENGTH=10000
